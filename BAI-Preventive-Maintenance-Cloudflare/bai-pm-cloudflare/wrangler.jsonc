{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bai-preventive-maintenance",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bai-preventive-maintenance",
      "database_id": "1fd1d0f3-f3a8-4bcc-bc58-4a9d7191c847",
      "migrations_dir": "migrations"
    }
  ]
}
